# Required: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Any Gemini model available on your key. If it is retired, the app switches to the best available Flash model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: requests per minute the app paces itself to (free tier is roughly 5–10).
# GEMINI_RPM=8

# Optional: max output tokens per generation request.
# GEMINI_MAX_OUTPUT_TOKENS=16384

# Optional: secret used to encrypt answer keys. Defaults to a key derived from GEMINI_API_KEY.
# EXAM_SECRET=a-long-random-string

# Per-file upload limit in MB. Used by both the browser and the server (sent via /api/health).
MAX_UPLOAD_MB=200

# Optional: size of each upload part in MB (default 8). Any reverse proxy must allow at least this.
# UPLOAD_CHUNK_MB=8

# Optional: where upload parts are stored until the file is complete (default: system temp dir).
# UPLOAD_TMP_DIR=/var/tmp/quizforge-uploads

# Optional: override the Gemini endpoint (proxies or local testing only).
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
